{
  "name": "@gitsang/dsh-terminal-color",
  "version": "0.1.0",
  "description": "Choose a light, dark, or follow-appearance palette for the sidebar terminal from the component’s Plugins configuration page.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "terminal",
    "color",
    "theme"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitsang/dsh-qol.git",
    "directory": "packages/dsh-terminal-color"
  },
  "homepage": "https://github.com/gitsang/dsh-qol/tree/main/packages/dsh-terminal-color#readme",
  "bugs": {
    "url": "https://github.com/gitsang/dsh-qol/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
